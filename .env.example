# Copy this file to .env and restart npm start. Never commit .env.
# Server-side Alchemy API key for Wallet Profiler. Empty = Blockscout only.
ALCHEMY_API_KEY=

# Optional Blockscout Pro key for the networks where the Wallet Analyzer fallback is enabled.
BLOCKSCOUT_API_KEY=

# Server-side Wallet Analyzer safety limits.
SCAN_MAX_WALLETS=500
SCAN_TASK_CONCURRENCY=4
ALCHEMY_REQUEST_CONCURRENCY=4
ALCHEMY_MIN_REQUEST_INTERVAL_MS=200
BLOCKSCOUT_REQUEST_CONCURRENCY=1
BLOCKSCOUT_MIN_REQUEST_INTERVAL_MS=400

# Moni Socials (server only). Local estimated monthly budget; not account balance.
MONI_API_KEY=
MONI_MONTHLY_BUDGET=300
MONI_DASHBOARD_TTL=21600000

# Optional server-side AIXBT title/description translation via Google Cloud Translation - Basic API.
# Leave empty to show the original AIXBT English text with an EN fallback marker.
GOOGLE_TRANSLATE_API_KEY=
